[Desktop Entry]
Type=Application
Name=Tonic
Comment=An elegant Apple Music desktop client
Exec=tonic %U
Icon=tonic
Terminal=false
Categories=AudioVideo;Audio;Music;
MimeType=x-scheme-handler/itms;
StartupWMClass=tonic
Actions=PlayPause;Next;Previous;Stop;

[Desktop Action PlayPause]
Name=Play-Pause
Exec=dbus-send --print-reply --dest=org.mpris.MediaPlayer2.tonic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.PlayPause

[Desktop Action Next]
Name=Next
Exec=dbus-send --print-reply --dest=org.mpris.MediaPlayer2.tonic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Next

[Desktop Action Previous]
Name=Previous
Exec=dbus-send --print-reply --dest=org.mpris.MediaPlayer2.tonic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Previous

[Desktop Action Stop]
Name=Stop
Exec=dbus-send --print-reply --dest=org.mpris.MediaPlayer2.tonic /org/mpris/MediaPlayer2 org.mpris.MediaPlayer2.Player.Stop
